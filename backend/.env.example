ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://hub:hub@localhost:15432/hub
# Local demo tokens. Any ENVIRONMENT other than local refuses values that start with dev-.
# Production tokens come from a secret store and are not written in this file.
HUB_RECRUITER_TOKEN=dev-recruiter-token
HUB_ENGINEER_TOKEN=dev-engineer-token
STORAGE_DIR=./var/storage
PROCESSING_VERSION=1
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=3
MAX_UPLOAD_BYTES=20971520
EMBEDDING_DIMENSIONS=1024
EXTRACTOR_PROVIDER=deterministic
EMBEDDING_PROVIDER=local
REQUIREMENT_PROVIDER=deterministic
# Starting values for the evaluation set. Change these while tuning; they are not a final decision.
IDENTITY_HIGH_CONFIDENCE=0.98
IDENTITY_RELATIONSHIP_CUTOFF=0.5
IDENTITY_WEIGHT_EMAIL=0.90
IDENTITY_WEIGHT_PHONE=0.80
IDENTITY_WEIGHT_NAME=0.50
IDENTITY_WEIGHT_DATES=0.40
IDENTITY_WEIGHT_EXPLICIT_VERSION=0.25
IDENTITY_WEIGHT_EMPLOYMENT=0.15
IDENTITY_WEIGHT_EDUCATION=0.10
IDENTITY_WEIGHT_SKILLS=0.10
IDENTITY_WEIGHT_SEMANTIC=0.15
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=hr-hub@cadence.local
MAIL_DESTINATION=smtp
