+import { ErrorState } from "@/components/ui/states";
+import { StatusText } from "@/components/ui/tag";
+
+const ACTOR: Record<string, { label: string; tone: "decided" | "neutral" | "proposed" }> = {
+  user: { label: "Person", tone: "decided" },
+  system: { label: "System", tone: "neutral" },
+  agent: { label: "Cadence agent", tone: "proposed" },
+};
+
+/**
+ * The API exposes the latest events across the desk (on the dashboard) and a full history per candidate and per file.
+ * There is no endpoint for the whole log, so this page says exactly what it shows.
+ */
+export function AuditTrail() {
+  const { data, error, loading, reload } = useAsync(() => getDashboard(), []);
+  return (
+    <>
+      <PageHeader
+        eyebrow="Oversight"
+        title="Audit trail"
+        sub="Every important action is recorded, append-only. Rows carry ids and action codes, never CV text or contact details."
+      />
+      {error ? <ErrorState error={error} onRetry={reload} /> : null}
+      {loading && !data ? (
+        <div aria-busy="true">
+          <PanelSkeleton rows={6} />
+        </div>
+      ) : null}
+      {data ? (
+        <div className="grid grid-cols-[minmax(0,1fr)] gap-6 xl:grid-cols-[minmax(0,1fr)_20rem]">
+          <Panel as="section">
+            <PanelHeader eyebrow="Across the desk" title={`Latest ${data.recent_activity.length} events`} />
+            {data.recent_activity.length === 0 ? (
+              <p className="px-5 py-6 text-mut">No events yet.</p>
+            ) : (
+              <table className="w-full border-collapse text-left text-[13.5px]">
+                <caption className="sr-only">Latest audit events</caption>
+                <thead>
+                  <tr className="bg-inset font-mono text-[11px] uppercase tracking-[0.12em] text-mut">
+                    <th scope="col" className="px-5 py-2.5 font-normal">Recorded</th>
+                    <th scope="col" className="px-3 py-2.5 font-normal">Actor</th>
+                    <th scope="col" className="px-5 py-2.5 font-normal">Action</th>
+                  </tr>
+                </thead>
+                <tbody>
+                  {data.recent_activity.map((e, i) => {
+                    const actor = ACTOR[e.actor_kind] ?? { label: e.actor_kind, tone: "neutral" as const };
+                    return (
+                      <tr key={`${e.created_at}-${i}`} className="border-t border-rule align-top">
+                        <td className="whitespace-nowrap px-5 py-3 font-mono text-[12px] text-mut">{shortDateTime(e.created_at)}</td>
+                        <td className="px-3 py-3">
+                          <StatusText tone={actor.tone}>{actor.label}</StatusText>
+                        </td>
+                        <td className="px-5 py-3 font-semibold">{labelAudit(e.action)}</td>
+                      </tr>
+                    );
+                  })}
+                </tbody>
+              </table>
+            )}
+          </Panel>
+          <aside className="space-y-4">
+            <Panel as="section" className="px-5 py-4">
+              <h2 className="text-[15px] font-semibold">Full history</h2>
+              <p className="mt-1.5 text-[13px] text-mut">
+                This desk shows the latest events only. Each candidate record, CV file and relationship review keeps its own complete
+                history:
+              </p>
+              <ul className="mt-3 space-y-2 text-[13px]">
+                <li className="flex gap-2">
+                  <Icon name="users" size={16} className="mt-0.5 text-mut" />
+                  <span>
+                    Open a candidate from <Link href="/candidates" prefetch={false}>Candidate intelligence</Link> and use <em>View history</em>.
+                  </span>
+                </li>
+                <li className="flex gap-2">
+                  <Icon name="upload" size={16} className="mt-0.5 text-mut" />
+                  <span>
+                    Select a file in <Link href="/intake" prefetch={false}>CV intake</Link> to see its record.
+                  </span>
+                </li>
+              </ul>
+            </Panel>
+            <Panel as="section" className="px-5 py-4 text-[13px] text-mut">
+              <h2 className="text-[15px] font-semibold text-ink">What an actor means</h2>
+              <ul className="mt-2 space-y-1.5">
+                <li><StatusText tone="decided">Person</StatusText> a recruiter took the action.</li>
+                <li><StatusText tone="neutral">System</StatusText> the worker or a deterministic rule.</li>
+                <li><StatusText tone="proposed">Cadence agent</StatusText> a background job proposed something.</li>
+              </ul>
+            </Panel>
+          </aside>
+        </div>
+      ) : null}
+    </>
+  );
+}
