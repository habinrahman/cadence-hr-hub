+  { id: "all", label: "All" },
+  { id: "strong", label: "Strong match" },
+  { id: "review", label: "Needs review" },
+];
+
+export function Pool({
+  matches,
+  shortlist,
+  busy,
+  jobTitle,
+  onShortlistSelected,
+  onReject,
+  onShare,
+}: {
+  matches: CandidateMatch[];
+  shortlist: Record<string, ShortlistState>;
+  busy: boolean;
+  jobTitle: string;
+  onShortlistSelected: (matchIds: string[]) => void;
+  onReject: (match: CandidateMatch) => void;
+  onShare: (match: CandidateMatch) => void;
+}) {
+  const [filters, setFilters] = useState<PoolFilters>(EMPTY_FILTERS);
+  const [selected, setSelected] = useState<Set<string>>(new Set());
+  const [limit, setLimit] = useState(PAGE);
+  const [rejecting, setRejecting] = useState<CandidateMatch | null>(null);
+  const hasLocation = matches.some((m) => m.location);
+  const shown = useMemo(() => {
+    const filtered = filterPool(matches, filters);
+    return [...filtered].sort((a, b) => {
+      const rank = (m: CandidateMatch) => (shortlist[m.candidate_id] === "yes" ? -1 : ORDER.indexOf(m.disposition));
+      return rank(a) - rank(b);
+    });
+  }, [matches, filters, shortlist]);
+
+  const toggle = (id: string) =>
+    setSelected((cur) => {
+      const next = new Set(cur);
+      if (next.has(id)) next.delete(id);
+      else next.add(id);
+      return next;
+    });
+
+  return (
+    <div className="space-y-3">
+      <p className="text-xs text-mut">Based on auto-extracted requirements</p>
+      <div className="flex flex-wrap items-end gap-3">
+        <div>
+          <p id="pool-status" className="mb-1 text-xs font-semibold">
+            Match status
+          </p>
+          <div role="radiogroup" aria-labelledby="pool-status" className="flex flex-wrap gap-1">
+            {STATUSES.map((option) => {
+              const on = filters.matchStatus === option.id;
+              return (
+                <button
+                  key={option.id}
+                  type="button"
+                  role="radio"
+                  aria-checked={on}
+                  className={`min-h-9 rounded-[3px] border px-2.5 text-xs font-semibold ${
+                    on ? "border-human bg-human-bg text-human-ink" : "border-rule-strong bg-panel text-ink"
+                  }`}
+                  onClick={() => setFilters((cur) => ({ ...cur, matchStatus: option.id }))}
+                >
+                  {option.label}
+                </button>
+              );
+            })}
+          </div>
+        </div>
+        <label className="text-xs font-semibold">
+          Skill
+          <input
+            className={`${inputClass} mt-1`}
+            value={filters.skill}
+            onChange={(e) => setFilters((cur) => ({ ...cur, skill: e.target.value }))}
+          />
+        </label>
+        {hasLocation ? (
+          <label className="text-xs font-semibold">
+            Location
+            <input
+              className={`${inputClass} mt-1`}
+              value={filters.location}
+              onChange={(e) => setFilters((cur) => ({ ...cur, location: e.target.value }))}
+            />
+          </label>
+        ) : null}
+        <label className="text-xs font-semibold">
+          Minimum years
+          <input
+            type="number"
+            min={0}
+            className={`${inputClass} mt-1 w-28`}
+            value={filters.minYears ?? ""}
+            onChange={(e) =>
+              setFilters((cur) => ({ ...cur, minYears: e.target.value === "" ? null : Number(e.target.value) }))
+            }
+          />
+        </label>
+      </div>
+      <p className="text-sm text-mut">
+        {shown.length} result{shown.length === 1 ? "" : "s"}
+      </p>
+
+      {shown.length === 0 ? (
+        <p className="text-mut">No candidates match these filters.</p>
+      ) : (
+        <Panel>
+          {shown.slice(0, limit).map((m, index) => {
+            const state = shortlist[m.candidate_id] ?? "loading";
+            const shortlistable = ["recommended", "needs_review"].includes(m.disposition);
+            return (
+              <MatchCard
+                key={m.id}
+                match={m}
+                state={state}
+                busy={busy}
+                openMatrix={index < 3}
+                selectable={state !== "yes" && shortlistable}
+                selected={selected.has(m.id)}
+                onToggle={() => toggle(m.id)}
+                onShortlist={() => onShortlistSelected([m.id])}
+                onReject={() => setRejecting(m)}
+                onShare={() => onShare(m)}
+              />
+            );
+          })}
+        </Panel>
+      )}
+      {shown.length > limit ? (
+        <Button onClick={() => setLimit(limit + PAGE)}>Show {Math.min(PAGE, shown.length - limit)} more</Button>
+      ) : null}
+
+      <div
+        role="region"
+        aria-label="Shortlist selection"
+        className="sticky bottom-0 flex items-center justify-between gap-3 border border-rule bg-panel px-4 py-3"
+      >
+        <span className="text-sm">{selected.size} selected</span>
+        <Button
+          variant="primary"
+          disabled={selected.size === 0}
+          busy={busy}
+          onClick={() => {
+            const ids = [...selected];
+            setSelected(new Set());
+            onShortlistSelected(ids);
+          }}
+        >
+          Shortlist selected ({selected.size})
+        </Button>
+      </div>
+
+      <ConfirmDialog
+        open={rejecting !== null}
+        title="Reject this candidate?"
+        body={
+          <p>
+            Reject <strong>{rejecting?.candidate_name ?? "this candidate"}</strong> for {jobTitle}? The decision is recorded in the audit trail.
+          </p>
+        }
+        confirmLabel="Reject candidate"
+        tone="danger"
+        busy={busy}
+        onConfirm={() => {
+          const m = rejecting;
+          setRejecting(null);
+          if (m) onReject(m);
+        }}
+        onCancel={() => setRejecting(null)}
+      />
+    </div>
+  );
+}
diff --git a/web/app/hiring/processing-card.tsx b/web/app/hiring/processing-card.tsx
new file mode 100644
index 0000000..81efc35
--- /dev/null
+++ b/web/app/hiring/processing-card.tsx
@@ -0,0 +1,76 @@
+"use client";
+
+import type { ReactNode } from "react";
+import type { Processing } from "@/lib/api";
+import { REQUEST_STATUS } from "@/lib/labels";
+import { Button, LinkButton } from "@/components/ui/button";
+import { Panel } from "@/components/ui/panel";
+import { StatusText } from "@/components/ui/tag";
+
+const ORDER = ["received", "extracting", "matching", "complete"] as const;
+
+function Row({ done, active, children }: { done: boolean; active: boolean; children: ReactNode }) {
+  return (
+    <li className="flex items-center gap-2 text-[14px]">
+      <span aria-hidden="true" className={done ? "text-ok-ink" : active ? "text-human-ink" : "text-mut"}>
+        {done ? "✓" : active ? "…" : "○"}
+      </span>
+      <span className={done || active ? "" : "text-mut"}>{children}</span>
+    </li>
+  );
+}
+
+export function ProcessingCard({
+  processing,
+  status,
+  onRetry,
+}: {
+  processing: Processing;
+  status: string;
+  onRetry: () => void;
+}) {
+  const at = ORDER.indexOf(processing.stage as (typeof ORDER)[number]);
+  const failed = processing.stage === "failed";
+  const complete = processing.stage === "complete";
+  return (
+    <section
+      aria-label="Request processing"
+      aria-busy={processing.stage === "received" || processing.stage === "extracting" || processing.stage === "matching"}
+    >
+      <Panel className="space-y-3 p-5">
+        <div className="flex items-center justify-between gap-3">
+          <h2 className="font-mono text-[11px] uppercase tracking-[0.16em] text-mut">Request received</h2>
+          <StatusText tone={status === "open" ? "ok" : "neutral"}>{REQUEST_STATUS[status] ?? status}</StatusText>
+        </div>
+        <ul className="space-y-1.5">
+          <Row done active={false}>
+            Request received
+          </Row>
+          <Row done={at >= 2} active={processing.stage === "extracting"}>
+            {processing.stage === "extracting" ? "Extracting requirements" : "Requirements extracted"}
+          </Row>
+          <Row done={complete} active={processing.stage === "matching"}>
+            {processing.stage === "matching" ? "Matching candidates" : "Candidate matching completed"}
+          </Row>
+        </ul>
+        {failed ? (
+          <div role="alert" className="flex flex-wrap items-center gap-3">
+            <span className="text-bad-ink">Automatic processing failed.</span>
+            <Button onClick={onRetry}>Retry processing</Button>
+          </div>
+        ) : null}
+        {complete ? (
+          <div className="flex flex-wrap items-center justify-between gap-3 border-t border-rule pt-3">
+            <p>
+              <span className="text-[22px] font-semibold tabular-nums">{processing.matched_count} candidates matched</span>
+              {processing.requested_count ? <span className="ml-3 text-mut">Requested: {processing.requested_count}</span> : null}
+            </p>
+            <LinkButton variant="primary" href="#pool">
+              View candidate pool
+            </LinkButton>
+          </div>
+        ) : null}
+      </Panel>
+    </section>
+  );
+}
